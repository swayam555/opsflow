# Everything has a local default. Change the tokens and passwords for anything beyond your laptop.

# Port of the console and API
OPSFLOW_PORT=8090
# API token for the console and scripts (full access). 12+ characters.
OPSFLOW_API_TOKEN=opsflow-dev-token
# Optional read-only token, e.g. for a wallboard
OPSFLOW_VIEWER_TOKEN=
# Shared secret between the services (16+ characters)
OPSFLOW_INTERNAL_TOKEN=opsflow-internal-change-me
OPSFLOW_DB_PASSWORD=opsflow-db-dev
OPSFLOW_DB_ROOT_PASSWORD=opsflow-root-dev
OPSFLOW_TIMEZONE=Asia/Kolkata

# AI triage (optional). Any OpenAI-compatible API; Groq by default.
OPSFLOW_LLM_API_KEY=
OPSFLOW_LLM_BASE_URL=https://api.groq.com/openai/v1
OPSFLOW_LLM_MODEL=llama-3.1-8b-instant

# Slack (optional): an incoming-webhook URL
OPSFLOW_SLACK_WEBHOOK_URL=

# Jira Cloud (optional): all four to mirror issues into Jira
OPSFLOW_JIRA_BASE_URL=
OPSFLOW_JIRA_EMAIL=
OPSFLOW_JIRA_API_TOKEN=
OPSFLOW_JIRA_PROJECT=
OPSFLOW_TRACKER_PROJECT=INC

OPSFLOW_DEPLOY_ENVIRONMENTS=dev,staging,production
